---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { stripLangFromSlug } from '../../i18n/utils';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  const de = all.filter((e) => e.slug.startsWith('de/'));
  const en = all.filter((e) => e.slug.startsWith('en/'));
  return de.map((entry) => {
    const counterpart = en.find((e) => e.data.translationKey === entry.data.translationKey);
    // ZWEI Dinge, die vorher vermischt waren (korrigiert 4.10.2026):
    // 1. altUrl = das ECHTE Gegenstueck. Nur das darf als hreflang raus. Fehlt
    //    die Uebersetzung, wurde hier "/en/" eingesetzt - damit hat die Seite
    //    Google gemeldet, die englische Startseite sei die Uebersetzung dieses
    //    Artikels. Jetzt bleibt altUrl in dem Fall leer.
    // 2. Der abschliessende Schraegstrich MUSS mit: die Zieladresse lautet
    //    /en/blog/<slug>/ und Google verlangt im hreflang genau die kanonische
    //    Adresse. Ohne Schraegstrich war das Sprachpaar ungueltig.
    const altUrl = counterpart ? `/en/blog/${stripLangFromSlug(counterpart.slug)}/` : undefined;
    return { params: { slug: stripLangFromSlug(entry.slug) }, props: { entry, altUrl } };
  });
}

const { entry, altUrl } = Astro.props;
const { Content, headings } = await entry.render();
---
<ArticleLayout entry={entry} lang="de" altUrl={altUrl} switchUrl="/en/blog/" headings={headings}>
  <Content />
</ArticleLayout>
