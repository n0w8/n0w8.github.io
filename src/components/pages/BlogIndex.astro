---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../ArticleCard.astro';
import { useTranslations, localizedPath, getPostsByLang, postUrl, localizeCategory } from '../../i18n/utils';
import { catUrl } from '../../i18n/taxonomy';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPostsByLang(lang);

// Die Pfade sind jetzt echte Links auf die Kategorie-Seiten.
// Vorher waren es <button>-Elemente mit einem ?cat=-Filter in JavaScript: fuer
// Leser bequem, fuer Google unsichtbar (Query-Parameter = dieselbe Seite, keine
// eigene Ueberschrift, kein eigener Text). Jetzt ist jeder Pfad eine eigene,
// indexierbare Seite mit eigenem Einleitungstext (4.10.2026).
const kategorien = [...new Set(posts.map((p) => p.data.category))];
const reihenfolge = ['Geschichte', 'Mythologie', 'Runen & Symbole', 'Alltag & Kultur', 'Krieger & Schlachten', 'Rezepte', 'Musik'];
const pfade = reihenfolge
  .filter((c) => kategorien.includes(c))
  .map((c) => ({
    label: localizeCategory(c, lang),
    url: catUrl(c, lang),
    count: posts.filter((p) => p.data.category === c).length,
  }));
---

<BaseLayout title={t('blog.title')} description={t('blog.lede')} lang={lang} altUrl={localizedPath('/blog', lang === 'de' ? 'en' : 'de')}>
  <section class="container blog-head">
    <p class="eyebrow">{t('blog.eyebrow')}</p>
    <h1 class="blog-title">{t('blog.title')}</h1>
    <p class="blog-lede text-dim">{t('blog.lede')}</p>
    <nav class="filters" aria-label={t('blog.eyebrow')}>
      <span class="filter-btn active">{t('blog.filter.all')}<span class="filter-n">{posts.length}</span></span>
      {pfade.map((f) => (
        <a class="filter-btn" href={f.url}>{f.label}<span class="filter-n">{f.count}</span></a>
      ))}
    </nav>
  </section>

  <section class="container section">
    <div class="post-grid stagger" id="postGrid">
      {posts.map((post) => (
        <div class="post-item" data-cat={post.data.category}>
          <ArticleCard href={postUrl(post, lang)} title={post.data.title} description={post.data.description}
            category={post.data.category} pubDate={post.data.pubDate} lang={lang}
            heroImage={post.data.heroImage} readingTime={post.data.readingTime} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // Altlast-Weiterleitung: Links der Form /blog/?cat=Rezepte wurden fruher von
  // den Breadcrumbs und Filter-Knoepfen erzeugt und stehen moeglicherweise noch
  // in Pins oder im Google-Index. Sie landen jetzt auf der echten Kategorie-Seite.
  const urlCat = new URLSearchParams(location.search).get('cat');
  if (urlCat) {
    const ziel = document.querySelector<HTMLAnchorElement>(
      `.filters a[href*="/${urlCat
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/ß/g, 'ss')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')}/"]`,
    );
    if (ziel) location.replace(ziel.href);
  }
</script>

<style>
  .blog-head { padding-top: 3.5rem; text-align: center; }
  .blog-title { font-size: clamp(2.4rem, 6vw, 3.6rem); margin: 0.6rem 0 1rem; }
  .blog-lede { max-width: 54ch; margin: 0 auto 2rem; font-size: 1.1rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; }
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-title);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-dim);
    /* Nur Farbe und Rahmen animieren statt "all" - all loest auch Layout-
       Eigenschaften mit aus und kostet bei jedem Hover unnoetige Rechenzeit. */
    transition: color 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }
  .filter-btn:hover { border-color: var(--color-bronze-dim); color: var(--color-parchment); }
  .filter-btn.active { background: var(--color-bronze); border-color: var(--color-bronze); color: var(--color-void); }
  .filter-n { font-size: 0.72rem; opacity: 0.6; }
  .section { padding: 2.5rem 1.5rem 4rem; }
  .post-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  @media (max-width: 900px) { .post-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .post-grid { grid-template-columns: 1fr; } }
</style>
